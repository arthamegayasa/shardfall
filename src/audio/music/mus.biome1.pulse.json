{
  "id": "mus.biome1.pulse",
  "bpm": 116,
  "meter": [4, 4],
  "stepsPerBeat": 4,
  "key": { "root": "D", "mode": "dorian" },
  "glintLadder": ["D6", "E6", "G6", "A6", "B6", "D7", "E7", "G7"],
  "form": ["A", "B"],
  "sections": {
    "A": { "chords": ["Dm", "G", "Bb", "C", "Dm", "G", "Am", "A7"] },
    "B": { "chords": ["Bb", "C", "Am", "Dm", "G", "Bb", "Csus4", "A7"] }

      { "fromPulse": 8, "level": 2 }
    ],
    "progressSteps": [
      { "atProgress": 0.35, "add": 1 },
      { "atProgress": 0.7, "add": 2 }
    ],
    "pressure": { "enemiesAlive": 60, "add": 1, "holdBars": 2 },
    "wardenAliveMinLevel": 2,
    "quantize": "bar",
    "fadeInBeats": 1,

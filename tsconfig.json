{
  // Browser program: all of src/, tests/, config files. Lib DOM.
  // src/sim, src/core, src/content are checked again without DOM by tsconfig.sim.json.
  // art/**/*.ts: AD sprite generators (bundled through src/app/assets.ts).
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "types": ["vite/client", "node"]
  },
  "include": [
    "src/**/*.ts",
    "art/**/*.ts",
    "tests/**/*.ts",
    "vite.config.ts",
    "playwright.config.ts",
    "eslint.config.js"
  ]
}
